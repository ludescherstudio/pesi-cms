# ── pesi runtime artifacts — NEVER commit these ──────────────
# Backups are byte-for-byte copies of your page source. Committing one to a
# public repo leaks the full PHP source including PESI_PASSWORD.
*.pesi-backup.*
.pesi-throttle*
*.pesi-lock
*.pesi-tmp-*

# Client uploads belong to the site, not to the pesi package.
uploads/

# Manual pre-change backups
*.old

# ── Development files, excluded from the release branch ─────
# Every pushed branch and its history are public when the repository is
# public. Ignore rules and export-ignore are not privacy boundaries.
CLAUDE.md
AGENTS.md

# Regression suite. Deliberately not shipped: the repository shows users the
# files they install and the docs to read, nothing else. The suite still
# matters — see the Testing section in CLAUDE.md for how to restore it from
# git history and when to run it.
dev/

# ── Local tooling / editor config ────────────────────────────
.claude/
.codex/
.public-prep/
.vscode/
.idea/
*.code-workspace

# Local credentials and database exports
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.sql
*.sqlite
*.sqlite3

# ── OS / sync junk ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
._sync_*.db
.owncloudsync.log
*.~lock.*
